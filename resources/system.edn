 {:system/env
 #profile {:dev  :dev
           :test :test
           :prod :prod}

 :app/db
 {:jdbc-url #or [#env DATABASE_URL "jdbc:sqlite:data/pommes-connection.db"]}

 :app/migrations
 {:datasource    #ig/ref :app/db
  :migration-dir "migrations"}

 :app/routes
 {:datasource #ig/ref :app/migrations}

 :app/web
 {:router #ig/ref :app/routes}

 :server/http
 {:port    #long #or [#env PORT 3000]
  :host    #or [#env HTTP_HOST "0.0.0.0"]
  :handler #ig/ref :app/web}}
