# Set these two values before the first production deploy.
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Generated by infra/setup-server.sh. Keep this secret and stable.
SESSION_KEY=

APP_ENV=production
DATABASE_URL=jdbc:sqlite:/data/pommes-connection.db
PORT=3333
HTTP_HOST=0.0.0.0
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Djava.awt.headless=true
